{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.1.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "sslocalization",
    "id": "sslocalization",
    "version": "0.7.0",
    "url": "https://github.com/frto027/SimpleStupidLocalization",
    "additionalData": {
      "overrideSoName": "libsslocalization.so",
      "compileOptions": {
        "includePaths": [
          "shared/include"
        ]
      },
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "python3 ./extern/includes/mod-scripts/shared/build.py $0:?"
      ],
      "copy": [
        "python3 ./extern/includes/mod-scripts/shared/cpy.py $0:?"
      ],
      "debug": [
        "python3 ./extern/includes/mod-scripts/shared/debug.py $0:?"
      ],
      "log": [
        "python3 ./extern/includes/mod-scripts/shared/log.py $0:?"
      ],
      "profile": [
        "python3 ./extern/includes/mod-scripts/shared/profile.py $0:?"
      ],
      "restart": [
        "python3 ./extern/includes/mod-scripts/shared/restart.py $0:?"
      ]
    },
    "ndk": "^27.3.13750724",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "sslocalization.qmod"
  },
  "dependencies": [
    {
      "id": "mod-scripts",
      "versionRange": "^1.0.2",
      "additionalData": {}
    },
    {
      "id": "beatsaber-hook",
      "versionRange": "^6.4.1",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4008.0.0",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.6",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.6.1",
      "additionalData": {}
    },
    {
      "id": "fmt",
      "versionRange": "^11.0.2",
      "additionalData": {}
    }
  ]
}